# Codex OAuth reuse is the default OpenAI authentication path.
CODEX_HOME=~/.codex

# Runtime selection
GAIA_LLM_MODEL=gpt-5.5
GAIA_BROWSER_BACKEND=openclaw
GAIA_OPENCLAW_HEADLESS=0
GAIA_OPENCLAW_RAW_TREE_CHAR_LIMIT=36000

# Optional overrides
# GAIA_OPENCLAW_RUNTIME_DIR=/absolute/path/to/runtime/assets
# GAIA_RUNTIME_STATE_DIR=~/.gaia/runtime/embedded_openclaw
# OPENAI_API_KEY=only-for-explicit-manual-auth
